{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lucas-translate",
  "version": "0.1.0",
  "identifier": "com.lucas.translate",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "lucas-translate",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 380,
        "height": 650,
        "resizable": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; media-src https://dict.youdao.com; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "Apple Development: Lu Jack (37WCB246J7)"
    }
  }
}
