{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucas Translate",
  "version": "0.1.0",
  "identifier": "com.lucas.translate",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lucas Translate",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 380,
        "height": 650,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 500,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; media-src https://dict.youdao.com; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RjZDNEM0QjE3MkQ3MDkKUldRSjEzS3h4TVQyU08wS2U5ZDRRRUQ0R0thT1NOaHZLaG5RUWhWUWszQWgrc0pwMEhXRzg1RWsK",
      "endpoints": ["https://github.com/lucaslus/luca-translate/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
