pkgname=lucas-translate
pkgver=@VERSION@
pkgrel=1
pkgdesc='Desktop translation and offline OCR tool built with Tauri'
arch=('x86_64')
url='https://github.com/lucaslus/luca-translate'
license=('MIT')
depends=('glibc' 'gcc-libs' 'gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator'
         'openssl' 'dbus' 'libxcb' 'libx11' 'libxrandr' 'xdotool'
         'xclip' 'tesseract' 'tesseract-data-eng' 'tesseract-data-chi_sim')
optdepends=('gnome-keyring: Secret Service provider for storing API credentials'
            'python: Omarchy integration installer'
            'wl-clipboard: Wayland selection and OCR clipboard'
            'grim: Hyprland screenshot capture'
            'slurp: Hyprland interactive region selection')
options=('!debug')
source=('payload.tar.gz')
sha256sums=('@SHA256@')

package() {
  cp -a "$srcdir/usr" "$pkgdir/"
}
